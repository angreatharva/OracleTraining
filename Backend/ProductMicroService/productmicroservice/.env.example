PRODUCT_SERVER_PORT=8086
PRODUCT_APPLICATION_NAME=PRODUCT-SERVICE
PRODUCT_DB_URL=jdbc:mysql://localhost:3306/mydb
PRODUCT_DB_DRIVER=com.mysql.cj.jdbc.Driver
PRODUCT_DB_USERNAME=root
PRODUCT_DB_PASSWORD=replace_with_your_mysql_password
PRODUCT_JPA_DDL_AUTO=update
PRODUCT_JPA_SHOW_SQL=true
PRODUCT_EUREKA_REGISTER=true
PRODUCT_EUREKA_FETCH_REGISTRY=true
PRODUCT_EUREKA_URL=http://localhost:8080/eureka/
PRODUCT_EUREKA_HOSTNAME=localhost

# Authentication. The SAME secret must be set in every service and the gateway.
# Minimum 32 characters (HS256 needs a 256-bit key).
PRODUCT_JWT_SECRET=replace_with_a_long_random_shared_secret
PRODUCT_JWT_ISSUER=wealthtrack
PRODUCT_JWT_EXPIRY_SECONDS=3600
