BANK_SERVER_PORT=8083
BANK_APPLICATION_NAME=BANK-SERVICE
BANK_DB_URL=jdbc:mysql://localhost:3306/mydb
BANK_DB_DRIVER=com.mysql.cj.jdbc.Driver
BANK_DB_USERNAME=root
BANK_DB_PASSWORD=replace_with_your_mysql_password
BANK_JPA_DDL_AUTO=update
BANK_JPA_SHOW_SQL=true
BANK_EUREKA_REGISTER=true
BANK_EUREKA_FETCH_REGISTRY=true
BANK_EUREKA_URL=http://localhost:8080/eureka/
BANK_EUREKA_HOSTNAME=localhost
BANK_FEIGN_CONNECT_TIMEOUT_MS=3000
BANK_FEIGN_READ_TIMEOUT_MS=10000

# Authentication. The SAME secret must be set in every service and the gateway.
# Minimum 32 characters (HS256 needs a 256-bit key).
BANK_JWT_SECRET=replace_with_a_long_random_shared_secret
BANK_JWT_ISSUER=wealthtrack
BANK_JWT_EXPIRY_SECONDS=3600
