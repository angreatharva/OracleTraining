USER_SERVER_PORT=8082
USER_APPLICATION_NAME=USER-SERVICE
USER_DB_URL=jdbc:mysql://localhost:3306/mydb
USER_DB_DRIVER=com.mysql.cj.jdbc.Driver
USER_DB_USERNAME=root
USER_DB_PASSWORD=replace_with_your_mysql_password
USER_JPA_DDL_AUTO=update
USER_JPA_SHOW_SQL=true
USER_EUREKA_REGISTER=true
USER_EUREKA_FETCH_REGISTRY=true
USER_EUREKA_FETCH_INTERVAL_SECONDS=5
USER_EUREKA_URL=http://localhost:8080/eureka/
USER_EUREKA_HOSTNAME=localhost

# Authentication. The SAME secret must be set in every service and the gateway.
# Minimum 32 characters (HS256 needs a 256-bit key).
USER_JWT_SECRET=replace_with_a_long_random_shared_secret
USER_JWT_ISSUER=wealthtrack
USER_JWT_EXPIRY_SECONDS=3600
