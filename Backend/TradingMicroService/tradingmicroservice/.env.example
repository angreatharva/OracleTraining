TRADING_SERVER_PORT=8085
TRADING_APPLICATION_NAME=TRADING-SERVICE
TRADING_DB_URL=jdbc:mysql://localhost:3306/mydb
TRADING_DB_DRIVER=com.mysql.cj.jdbc.Driver
TRADING_DB_USERNAME=root
TRADING_DB_PASSWORD=replace_with_your_mysql_password
TRADING_JPA_DDL_AUTO=update
TRADING_JPA_SHOW_SQL=true
TRADING_EUREKA_REGISTER=true
TRADING_EUREKA_FETCH_REGISTRY=true
TRADING_EUREKA_URL=http://localhost:8080/eureka/
TRADING_EUREKA_HOSTNAME=localhost
TRADING_FEIGN_CONNECT_TIMEOUT_MS=3000
TRADING_FEIGN_READ_TIMEOUT_MS=10000

# Authentication. The SAME secret must be set in every service and the gateway.
# Minimum 32 characters (HS256 needs a 256-bit key).
TRADING_JWT_SECRET=replace_with_a_long_random_shared_secret
TRADING_JWT_ISSUER=wealthtrack
TRADING_JWT_EXPIRY_SECONDS=3600
